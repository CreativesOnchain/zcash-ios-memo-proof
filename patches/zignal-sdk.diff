+use std::{ffi::OsStr, ops::Range, os::unix::ffi::OsStrExt, path::Path, time::Duration};
+
+use anyhow::{Context, Result, ensure};
+use futures_util::StreamExt;
+use orchard::{
+    keys::{PreparedIncomingViewingKey, Scope},
+    note::ExtractedNoteCommitment,
+    note_encryption::{
+        CompactAction, CompactNoteCiphertextBytes, IronwoodDomain, NoteBytesData,
+        NoteCiphertextBytes,
+    },
+};
+use prost::Message;
+use rusqlite::{Connection, OptionalExtension, TransactionBehavior, params};
+use zakura_pir_client::enhance::{
+    AcceptedAnchor, ClientError, ClientResourceLimits, GenerationAcceptance,
+    transport::{Method, PendingClient, Request, ResponseBody, Transport},
+};
+use zcash_client_backend::{
+    data_api::chain::{BlockSource, error::Error as ChainError},
+    proto::compact_formats::CompactOrchardAction,
+};
+use zcash_client_sqlite::{FsBlockDb, error::SqliteClientError};
+use zcash_note_encryption::{EphemeralKeyBytes, ShieldedOutput, try_note_decryption};
+use zcash_protocol::consensus::{BlockHeight, NetworkType, NetworkUpgrade, Parameters};
+
+use crate::{NetworkParams, UnifiedFullViewingKey, WALLET_DB_BUSY_TIMEOUT};
+
+fn wallet_connection(path: &[u8]) -> Result<Connection> {
+    let conn = Connection::open(Path::new(OsStr::from_bytes(path)))?;
+    conn.busy_timeout(WALLET_DB_BUSY_TIMEOUT)?;
+    conn.pragma_update(None, "foreign_keys", true)?;
+    Ok(conn)
+}
+
+pub(crate) fn retain(cache: &FsBlockDb, path: &[u8], scanned: Range<BlockHeight>) -> Result<()> {
+    if scanned.is_empty() {
+        return Ok(());
+    }
+
+    let mut conn = wallet_connection(path)?;
+    let db = conn.transaction_with_behavior(TransactionBehavior::Immediate)?;
+    db.execute_batch(
+        "CREATE TABLE IF NOT EXISTS zignal_ironwood_pir_context (
+             note_id INTEGER PRIMARY KEY REFERENCES ironwood_received_notes(id) ON DELETE CASCADE,
+             height INTEGER NOT NULL REFERENCES blocks(height) ON DELETE CASCADE,
+             block_hash BLOB NOT NULL, position INTEGER NOT NULL, compact_action BLOB NOT NULL
+         );",
+    )?;
+    let size = usize::try_from(u32::from(scanned.end) - u32::from(scanned.start))?;
+    let mut insert = db.prepare_cached(
+        "INSERT OR REPLACE INTO zignal_ironwood_pir_context
+             (note_id, height, block_hash, position, compact_action)
+         SELECT n.id, b.height, b.hash, n.commitment_tree_position, ?5
+         FROM transactions t
+         JOIN ironwood_received_notes n ON n.transaction_id = t.id_tx
+         JOIN blocks b ON b.height = t.block
+         WHERE t.txid = ?1 AND n.action_index = ?2 AND b.height = ?3 AND b.hash = ?4
+           AND n.commitment_tree_position IS NOT NULL AND n.memo IS NULL",
+    )?;
+    cache
+        .with_blocks(Some(scanned.start), Some(size), |block| {
+            let hash = block.hash().0;
+            for tx in block.vtx {
+                for (index, action) in tx.ironwood_actions.iter().enumerate() {
+                    insert
+                        .execute(params![
+                            tx.txid,
+                            index as u32,
+                            block.height,
+                            hash,
+                            action.encode_to_vec()
+                        ])
+                        .map_err(|err| ChainError::Wallet(SqliteClientError::from(err)))?;
+                }
+            }
+            Ok(())
+        })
+        .map_err(|error| anyhow::anyhow!("Retaining scanned Ironwood context: {error}"))?;
+    drop(insert);
+    db.commit()?;
+    Ok(())
+}
+
+#[derive(Debug, PartialEq, Eq)]
+struct NoteContext {
+    id: i64,
+    height: u64,
+    position: u64,
+    compact: Vec<u8>,
+    ufvk: String,
+    scope: u8,
+    value: u64,
+    rho: Vec<u8>,
+    rseed: Vec<u8>,
+}
+
+fn pending(conn: &Connection, txid: &[u8]) -> Result<Vec<NoteContext>> {
+    let mut select = conn.prepare(
+        "SELECT n.id, c.height, c.position, c.compact_action, a.ufvk, n.recipient_key_scope,
+                n.value, n.rho, n.rseed
+         FROM transactions t
+         JOIN ironwood_received_notes n ON n.transaction_id = t.id_tx
+         JOIN accounts a ON a.id = n.account_id
+         JOIN zignal_ironwood_pir_context c ON c.note_id = n.id
+         JOIN blocks b ON b.height = t.block AND b.height = c.height AND b.hash = c.block_hash
+         WHERE t.txid = ?1 AND n.memo IS NULL AND n.note_version = 3
+           AND n.commitment_tree_position = c.position AND a.ufvk IS NOT NULL
+         ORDER BY n.id",
+    )?;
+    let rows = select.query_map([txid], |row| {
+        Ok(NoteContext {
+            id: row.get(0)?,
+            height: row.get(1)?,
+            position: row.get(2)?,
+            compact: row.get(3)?,
+            ufvk: row.get(4)?,
+            scope: row.get(5)?,
+            value: row.get(6)?,
+            rho: row.get(7)?,
+            rseed: row.get(8)?,
+        })
+    })?;
+    Ok(rows.collect::<rusqlite::Result<_>>()?)
+}
+
+fn scanned_anchor(conn: &Connection, height: u64) -> Result<AcceptedAnchor> {
+    let (mut hash, size): (Vec<u8>, u64) = conn
+        .query_row(
+            "SELECT hash, ironwood_commitment_tree_size FROM blocks WHERE height = ?1",
+            [height],
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .context("PIR anchor has not been scanned")?;
+    hash.reverse();
+    Ok(AcceptedAnchor::new(
+        height,
+        hash.try_into()
+            .map_err(|_| anyhow::anyhow!("Invalid scanned hash"))?,
+        size,
+    ))
+}
+
+struct FullOutput {
+    epk: EphemeralKeyBytes,
+    cmx: ExtractedNoteCommitment,
+    ciphertext: NoteCiphertextBytes,
+}
+
+impl ShieldedOutput<IronwoodDomain> for FullOutput {
+    fn ephemeral_key(&self) -> EphemeralKeyBytes {
+        self.epk.clone()
+    }
+    fn cmstar(&self) -> &ExtractedNoteCommitment {
+        &self.cmx
+    }
+    fn enc_ciphertext(&self) -> Option<&NoteCiphertextBytes> {
+        Some(&self.ciphertext)
+    }
+    fn enc_ciphertext_compact(&self) -> CompactNoteCiphertextBytes {
+        NoteBytesData(self.ciphertext.as_ref()[..52].try_into().expect("52 bytes"))
+    }
+}
+
+fn authenticate(
+    note: &NoteContext,
+    suffix: &[u8; 528],
+    network: NetworkParams,
+) -> Result<[u8; 512]> {
+    let wire = CompactOrchardAction::decode(note.compact.as_slice())?;
+    let action = CompactAction::try_from(&wire)
+        .map_err(|_| anyhow::anyhow!("Invalid scanned Ironwood action"))?;
+    let mut ciphertext = [0; 580];
+    ciphertext[..52].copy_from_slice(&wire.ciphertext);
+    ciphertext[52..].copy_from_slice(suffix);
+    let cmx = wire.cmx().map_err(|_| anyhow::anyhow!("Invalid cmx"))?;
+    let output = FullOutput {
+        epk: EphemeralKeyBytes(
+            wire.ephemeral_key
+                .try_into()
+                .map_err(|_| anyhow::anyhow!("Invalid epk"))?,
+        ),
+        cmx,
+        ciphertext: NoteBytesData(ciphertext),
+    };
+    let ufvk = UnifiedFullViewingKey::decode(&network, &note.ufvk)
+        .map_err(|_| anyhow::anyhow!("Invalid stored viewing key"))?;
+    let scope = match note.scope {
+        0 => Scope::External,
+        1 => Scope::Internal,
+        _ => anyhow::bail!("Unsupported recipient key scope"),
+    };
+    let ivk = PreparedIncomingViewingKey::new(
+        &ufvk
+            .orchard()
+            .context("Missing Orchard viewing key")?
+            .to_ivk(scope),
+    );
+    let (decrypted, _, memo) =
+        try_note_decryption(&IronwoodDomain::for_compact_action(&action), &ivk, &output)
+            .context("Ironwood note authentication failed")?;
+    ensure!(
+        decrypted.value().inner() == note.value
+            && decrypted.rho().to_bytes().as_slice() == note.rho
+            && decrypted.rseed().as_bytes().as_slice() == note.rseed,
+        "Recovered note differs from the wallet's scanned note"
+    );
+    Ok(memo)
+}
+
+struct Http(reqwest::Client);
+impl Transport for Http {
+    async fn execute(&self, request: Request) -> Result<ResponseBody, ClientError> {
+        let mut body = request.response_body();
+        let method = match request.method {
+            Method::Get => reqwest::Method::GET,
+            Method::Post => reqwest::Method::POST,
+        };
+        let mut response = self
+            .0
+            .request(method, request.url)
+            .header("content-type", "application/octet-stream")
+            .body(request.body)
+            .send()
+            .await
+            .map_err(|error| ClientError::Transport(error.to_string()))?;
+        if !response.status().is_success() {
+            return Err(ClientError::HttpStatus(response.status().as_u16()));
+        }
+        while let Some(chunk) = response
+            .chunk()
+            .await
+            .map_err(|error| ClientError::Transport(error.to_string()))?
+        {
+            body.extend(&chunk)?;
+        }
+        Ok(body.finish())
+    }
+}
+
+pub(crate) fn recover(
+    path: &[u8],
+    txid: &[u8],
+    origin: &str,
+    network: NetworkParams,
+) -> Result<i32> {
+    ensure!(txid.len() == 32, "Invalid transaction hash");
+    if network.network_type() != NetworkType::Main {
+        return Ok(0);
+    }
+    let origin = reqwest::Url::parse(origin)?;
+    let loopback = matches!(origin.host_str(), Some("127.0.0.1" | "[::1]" | "localhost"));
+    ensure!(
+        origin.scheme() == "https" || (origin.scheme() == "http" && loopback),
+        "Enhance PIR needs HTTPS or a loopback fixture"
+    );
+    ensure!(
+        origin.username().is_empty()
+            && origin.password().is_none()
+            && origin.query().is_none()
+            && origin.fragment().is_none(),
+        "Invalid PIR origin"
+    );
+
+    let db = wallet_connection(path)?;
+    let table_exists = db
+        .query_row(
+            "SELECT 1 FROM sqlite_master WHERE name = 'zignal_ironwood_pir_context'",
+            [],
+            |_| Ok(()),
+        )
+        .optional()?
+        .is_some();
+    if !table_exists {
+        return Ok(0);
+    }
+    let notes = pending(&db, txid)?;
+    if notes.is_empty() {
+        return Ok(0);
+    }
+    drop(db);
+
+    let activation = network
+        .activation_height(NetworkUpgrade::Nu6_3)
+        .context("Ironwood inactive")?;
+    let http = Http(
+        reqwest::Client::builder()
+            .redirect(reqwest::redirect::Policy::none())
+            .no_proxy()
+            .connect_timeout(Duration::from_secs(5))
+            .timeout(Duration::from_secs(45))
+            .build()?,
+    );
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()?;
+    let (anchor, updates) = runtime.block_on(async {
+        let generation = PendingClient::fetch(&http, origin.as_str())
+            .await
+            .context("PIR transport attempt failed")?;
+        let anchor = {
+            let db = wallet_connection(path)?;
+            scanned_anchor(&db, generation.manifest().anchor_height)?
+        };
+        ensure!(
+            notes.iter().all(|note| note.height <= anchor.height),
+            "PIR anchor predates a pending memo"
+        );
+        let acceptance = GenerationAcceptance::new(
+            "main",
+            u64::from(u32::from(activation)),
+            anchor.clone(),
+            ClientResourceLimits::new(32768),
+        );
+        let mut client = generation.accept(&acceptance)?;
+        let mut results =
+            std::pin::pin!(client.query_batch(&http, notes.iter().map(|note| note.position))?);
+        let mut updates = Vec::with_capacity(notes.len());
+        for note in &notes {
+            let result = results.next().await.context("Incomplete PIR query")?;
+            ensure!(
+                result.position == note.position,
+                "Unexpected PIR result position"
+            );
+            let memo = authenticate(note, result.record?.enc_ciphertext_suffix(), network)?;
+            updates.push((note.id, memo));
+        }
+        Ok::<_, anyhow::Error>((anchor, updates))
+    })?;
+
+    let mut db = wallet_connection(path)?;
+    let tx = db.transaction_with_behavior(TransactionBehavior::Immediate)?;
+    ensure!(
+        scanned_anchor(&tx, anchor.height)? == anchor && pending(&tx, txid)? == notes,
+        "Scanned note or anchor changed during PIR recovery"
+    );
+    for (id, memo) in updates {
+        ensure!(
+            tx.execute(
+                "UPDATE ironwood_received_notes SET memo = ?1 WHERE id = ?2 AND memo IS NULL",
+                params![memo.as_slice(), id]
+            )? == 1,
+            "Pending memo disappeared"
+        );
+    }
+    tx.commit()?;
+    Ok(1)
+}
