+/// Attempts native Enhance PIR recovery for one locally scanned transaction.
+///
+/// # Safety
+/// The database path and transaction ID must each point to the specified number
+/// of readable bytes, and origin must point to a valid null-terminated C string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn zcashlc_recover_ironwood_memos(
+    db_data: *const u8,
+    db_data_len: usize,
+    txid: *const u8,
+    txid_len: usize,
+    origin: *const c_char,
+    network_id: u32,
+) -> i32 {
+    let res = catch_panic(|| {
+        let network = parse_network(network_id)?;
+        let path = unsafe { slice::from_raw_parts(db_data, db_data_len) };
+        let id = unsafe { slice::from_raw_parts(txid, txid_len) };
+        let origin = unsafe { CStr::from_ptr(origin) }.to_str()?;
+        ironwood_pir::recover(path, id, origin, network)
+    });
+    unwrap_exc_or(res, -1)
+}
